# Copy to server/.env and fill in. Generate secrets with: openssl rand -base64 48
NODE_ENV=development
PORT=5001
LOG_LEVEL=info
# Set to true only behind a proxy/load balancer that sets X-Forwarded-For
TRUST_PROXY=false

# MongoDB Atlas (Database > Connect > Drivers). Tests use <MONGODB_DB>_test_<run id> on the same cluster and drop it.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=shop

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
INTERNAL_JOB_SECRET=

# The frontend's origin: the only origin CORS allows
APP_ORIGIN=http://localhost:3000
# Optional comma-separated, exact additional portal origins (for example a specific Firebase PR preview).
# NEVER add *.web.app / *.firebaseapp.com; credentialed CORS must have an explicit allowlist.
APP_ADDITIONAL_ORIGINS=

# Google Identity Services: create a Web application OAuth client in Google Cloud Console.
# This is a public client ID, not a client secret. Leave empty to keep Google sign-in disabled.
GOOGLE_CLIENT_ID=

# Cloudflare R2 (needed from the uploads phase; required in production)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# SMTP account for verification and password-reset email; empty in development prints emails to the console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Device app (Phase 2). The APK download link phones use during QR setup (https; required in production), and the
# SHA-256 of the app's signing certificate as URL-safe base64 without padding. See android/README.md for the command.
DEVICE_APP_APK_URL=
DEVICE_APP_SIGNATURE_CHECKSUM=

# Optional: approved customer APK release JSON. Empty = no customer-app download; QR setup still works.
# Generate from a real signed APK with the locker repo's scripts/customer_release.py.
# Keep each release at an immutable HTTPS URL. wifiOnly defaults to true.
CUSTOMER_APP_RELEASE_JSON=


GOOGLE_APPLICATION_CREDENTIALS=/srv/qist/firebase-admin.json

# Customer app service screens (only customer-app routes; staff/locker APIs are unaffected).
CUSTOMER_APP_MAINTENANCE=false

# Private customer documents. NEVER use the public APK bucket here.
# Leave unset until a separate private bucket and isolated processor are provisioned.
DOCUMENTS_R2_BUCKET=
DOCUMENTS_R2_ACCESS_KEY_ID=
DOCUMENTS_R2_SECRET_ACCESS_KEY=
DOCUMENT_PROCESSOR_URL=
DOCUMENT_PROCESSOR_SECRET=
